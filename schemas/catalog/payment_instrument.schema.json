{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bestpay:schema:payment-instrument:1.0.0",
  "title": "PaymentInstrumentCatalog",
  "description": "Complete catalog file envelope with typed items.",
  "allOf": [
    {
      "$ref": "urn:bestpay:schema:catalog-root:1.0.0"
    },
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogItem"
          }
        }
      }
    }
  ],
  "$defs": {
    "stableIdSet": {
      "type": "array",
      "items": {
        "$ref": "urn:bestpay:schema:stable-id:1.0.0"
      },
      "uniqueItems": true
    },
    "sourceReferenceSet": {
      "type": "array",
      "items": {
        "$ref": "urn:bestpay:schema:source-reference:1.0.0"
      },
      "uniqueItems": true
    },
    "nullableDate": {
      "anyOf": [
        {
          "$ref": "urn:bestpay:schema:date:1.0.0"
        },
        {
          "type": "null"
        }
      ]
    },
    "textSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "catalogItem": {
      "title": "PaymentInstrument",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "shortName",
        "instrumentType",
        "issuerName",
        "partnerInstitutionName",
        "availableBrandIds",
        "annualFee",
        "supportedModeIds",
        "supportedRouteIds",
        "validFrom",
        "validUntilExclusive",
        "status",
        "sourceIds",
        "lastVerifiedAt",
        "displayClaims",
        "tags",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "urn:bestpay:schema:stable-id:1.0.0"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string",
          "minLength": 1
        },
        "instrumentType": {
          "type": "string",
          "minLength": 1
        },
        "issuerName": {
          "type": "string",
          "minLength": 1
        },
        "partnerInstitutionName": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "availableBrandIds": {
          "$ref": "#/$defs/stableIdSet"
        },
        "annualFee": {
          "type": "integer",
          "minimum": 0
        },
        "supportedModeIds": {
          "$ref": "#/$defs/stableIdSet"
        },
        "supportedRouteIds": {
          "$ref": "#/$defs/stableIdSet"
        },
        "validFrom": {
          "$ref": "urn:bestpay:schema:date:1.0.0"
        },
        "validUntilExclusive": {
          "$ref": "#/$defs/nullableDate"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "unverified",
            "active",
            "inactive",
            "deprecated",
            "superseded",
            "historical",
            "archived"
          ]
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceReferenceSet"
        },
        "lastVerifiedAt": {
          "$ref": "urn:bestpay:schema:date:1.0.0"
        },
        "displayClaims": {
          "$ref": "#/$defs/textSet"
        },
        "tags": {
          "$ref": "#/$defs/stableIdSet"
        },
        "notes": {
          "$ref": "#/$defs/textSet"
        }
      }
    }
  }
}
