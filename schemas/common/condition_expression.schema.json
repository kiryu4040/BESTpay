{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bestpay:schema:condition-expression:1.0.0",
  "title": "ConditionExpression",
  "description": "Recursive condition expression. Depth and total node count are validated separately.",
  "oneOf": [
    {
      "$ref": "#/$defs/allNode"
    },
    {
      "$ref": "#/$defs/anyNode"
    },
    {
      "$ref": "#/$defs/notNode"
    },
    {
      "$ref": "#/$defs/conditionNode"
    },
    {
      "$ref": "#/$defs/comparisonNode"
    }
  ],
  "$defs": {
    "allNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeType",
        "children"
      ],
      "properties": {
        "nodeType": {
          "const": "all"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#"
          }
        }
      }
    },
    "anyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeType",
        "children"
      ],
      "properties": {
        "nodeType": {
          "const": "any"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#"
          }
        }
      }
    },
    "notNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeType",
        "child"
      ],
      "properties": {
        "nodeType": {
          "const": "not"
        },
        "child": {
          "$ref": "#"
        }
      }
    },
    "conditionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeType",
        "conditionId"
      ],
      "properties": {
        "nodeType": {
          "const": "condition"
        },
        "conditionId": {
          "$ref": "urn:bestpay:schema:stable-id:1.0.0"
        }
      }
    },
    "comparisonNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeType",
        "conditionId",
        "comparisonOperator",
        "value"
      ],
      "properties": {
        "nodeType": {
          "const": "comparison"
        },
        "conditionId": {
          "$ref": "urn:bestpay:schema:stable-id:1.0.0"
        },
        "comparisonOperator": {
          "type": "string",
          "enum": [
            "equals",
            "notEquals",
            "greaterThan",
            "greaterThanOrEqual",
            "lessThan",
            "lessThanOrEqual",
            "in",
            "notIn"
          ]
        },
        "value": {
          "$ref": "#/$defs/comparisonValue"
        }
      }
    },
    "comparisonValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "$ref": "urn:bestpay:schema:rational:1.0.0"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "uniqueItems": true
        }
      ]
    }
  }
}
